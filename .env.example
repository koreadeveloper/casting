# 로컬 시범 운영용. 반드시 24자 이상의 긴 임의 문자열로 바꾸세요.
SESSION_SECRET=change-this-to-a-long-random-secret

# 데이터베이스: Supabase Postgres. 대시보드 Connect → Direct → Session pooler 문자열을 넣으세요.
DATABASE_URL=postgresql://postgres.<프로젝트ID>:<비밀번호>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Vercel 체험용 샘플 데이터와 바로 입장 버튼 (버튼은 NEXT_PUBLIC_DEMO_MODE로 보인다). 운영에서는 둘 다 비워 둡니다.
# DEMO_MODE=true
# NEXT_PUBLIC_DEMO_MODE=true

# AI 기능(프로필 PDF·사진 읽기, 인증 서류 읽기). 키가 없으면 해당 기능은 '준비 중'으로 보입니다.
# MonoRouter를 쓸 때는 Universal 키를 넣고 주소는 Claude 전용 경로로 둡니다(SDK가 /v1/messages를 붙입니다).
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://monogpt.kr/api/monorouter/v1/anthropic
# 모델을 바꾸려면(기본: claude-sonnet-5-5)
# PROFILE_AI_MODEL=
# VERIFY_AI_MODEL=

# 사진·PDF 저장: Supabase Storage (비공개 버킷 `uploads`). 둘 다 없으면 로컬 data/uploads/에 저장한다.
# 시크릿 키는 서버 전용이다. 절대 NEXT_PUBLIC_ 이름으로 노출하지 마세요.
# SUPABASE_URL=https://<프로젝트ID>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...

# 메일 발송(Resend): 학교 메일 인증 코드, 문의 알림. 두 값이 다 있어야 보낸다.
# 운영에서 없으면 학교 메일 인증은 '준비 중'으로 보이고, 문의는 DB(inquiries)에만 저장된다.
# 아무 주소로나 보내려면 Resend에서 우리 도메인을 인증하고 그 도메인 주소를 MAIL_FROM에 쓴다
# (vercel.app 주소는 도메인 인증을 할 수 없다).
# RESEND_API_KEY=re_...
# MAIL_FROM=캐스팅플로우 <no-reply@우리도메인>
# 문의 알림 메일 속 링크에 쓸 사이트 주소(비우면 요청이 들어온 주소를 쓴다)
# APP_URL=https://casting-swipe.vercel.app

# 소셜 로그인(구글·카카오). 키가 있는 제공자의 버튼만 로그인·가입 화면에 나타난다.
# 콜백 주소(각 콘솔에 등록): <사이트 주소>/api/auth/google/callback, <사이트 주소>/api/auth/kakao/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=

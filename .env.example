# 로컬 시범 운영용. 반드시 24자 이상의 긴 임의 문자열로 바꾸세요.
SESSION_SECRET=change-this-to-a-long-random-secret

# 데이터베이스: Neon Postgres. Vercel Storage에서 Neon을 연결한 뒤
# `npx vercel env pull .env.local`로 받거나, 직접 연결 문자열을 넣으세요.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Vercel 체험용 샘플 데이터와 바로 입장 버튼
# DEMO_MODE=true

# AI 기능(프로필 PDF·사진 읽기, 인증 서류 읽기). 키가 없으면 해당 기능은 '준비 중'으로 보입니다.
# MonoRouter를 쓸 때는 Universal 키를 넣고 주소는 Claude 전용 경로로 둡니다(SDK가 /v1/messages를 붙입니다).
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://monogpt.kr/api/monorouter/v1/anthropic
# 모델을 바꾸려면(기본: claude-sonnet-5-5)
# PROFILE_AI_MODEL=
# VERIFY_AI_MODEL=
